{
  "name": "notification-service",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Notification service for project management system",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@pm/backend-common": "file:../packages/backend-common",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.2",
    "pg": "^8.17.2",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.9",
    "@types/node-schedule": "^2.1.7",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "jest": "^30.0.2",
    "nodemailer-mock": "^2.0.6",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
