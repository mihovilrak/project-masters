# PostgreSQL environments
POSTGRES_USER=pm
POSTGRES_DB=pm_db
POSTGRES_PASSWORD=<CHANGE_ME>
TZ=Europe/Zagreb # Timezone

# Admin user: used by db/seed-admin.sh after DB init to create/update the default admin (login: admin)
ADMIN_PASSWORD=<CHANGE_ME>

# Backend environments (required in production: SESSION_SECRET, FE_URL)
SESSION_SECRET=<CHANGE_ME>
NODE_ENV=production
FE_URL=http://localhost:3000

# Email Configuration
EMAIL_ENABLED=true
EMAIL_HOST=smtp.provider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=some.email@provider.com
EMAIL_PASSWORD=<CHANGE_ME>
EMAIL_FROM=Project Management <some.email@provider.com>
NOTIFICATION_RATE_LIMIT=100
# Shared secret for the notification service API (openssl rand -hex 32).
# The service refuses every request when this is unset.
NOTIFICATION_API_KEY=<CHANGE_ME>
LOG_LEVEL=info
