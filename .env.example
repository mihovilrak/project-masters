# PostgreSQL environments
POSTGRES_USER=pm
POSTGRES_DB=pm_db
POSTGRES_PASSWORD=<CHANGE_ME>
TZ=Europe/Zagreb # Timezone

# Admin user: used by db/seed-admin.sh after DB init to create/update the default admin (login: admin)
ADMIN_PASSWORD=<CHANGE_ME>

# Backend environments (required in production: SESSION_SECRET, FE_URL)
SESSION_SECRET=<CHANGE_ME>
NODE_ENV=production
FE_URL=http://localhost:3000
# Public URL used to build links in notification emails (defaults to FE_URL)
APP_BASE_URL=http://localhost:3000

# Email Configuration
EMAIL_ENABLED=true
EMAIL_HOST=smtp.provider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=some.email@provider.com
EMAIL_PASSWORD=<CHANGE_ME>
EMAIL_FROM=Project Management <some.email@provider.com>
LOG_LEVEL=info
