# PostgreSQL environments
POSTGRES_USER=pm
POSTGRES_DB=pm_db
POSTGRES_PASSWORD=<CHANGE_ME>
TZ=Europe/Zagreb # Timezone

# Non-superuser role the api and notification-service connect as (created by db/migrate.sh)
APP_DB_USER=pm_app
APP_DB_PASSWORD=<CHANGE_ME>

# Daily pg_dump time (HH:MM in TZ), written to ./db/backup
BACKUP_TIME=00:00
# Days of dumps to keep in ./db/backup
BACKUP_RETENTION_DAYS=30

# Admin user: created by db/seed-admin.sh if missing (login: admin).
# Set ADMIN_PASSWORD_FORCE_RESET=true to overwrite an existing admin's password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<CHANGE_ME>
ADMIN_PASSWORD_FORCE_RESET=false

# Backend environments (required in production: SESSION_SECRET, FE_URL)
SESSION_SECRET=<CHANGE_ME>
NODE_ENV=production
FE_URL=http://localhost:3000

# SMTP credentials. Host, port, TLS, sender address and the enable switch are
# managed in Settings > System Settings and stored in the database.
EMAIL_USER=some.email@provider.com
EMAIL_PASSWORD=<CHANGE_ME>
LOG_LEVEL=info

# Set to true to log notification-service counters every 30 seconds
METRICS_ENABLED=false
