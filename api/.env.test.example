# Copy to .env.test and adjust. Used by: yarn test:integration:local
# (Run yarn setup-test-db first to start the Docker test DB on port 5433.)
# After DB schema changes, re-run yarn setup-test-db (it applies only changed db/init scripts).
# The app connects as the non-superuser TEST_DB_USER; fixtures seed/truncate as TEST_DB_ADMIN_USER.

TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=pm_test
TEST_DB_USER=pm_app
TEST_DB_ADMIN_USER=pm_user
TEST_DB_ADMIN_PASSWORD=pm_password
TEST_DB_PASSWORD=pm_app_password
SESSION_SECRET=test
