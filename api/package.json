{
  "name": "project-management-backend",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Backend for Project management application",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "tsc",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "watch": "tsc -w",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest --config src/__tests__/jest.config.ts",
    "test:unit": "jest --config src/__tests__/jest.config.ts",
    "test:watch": "jest --config src/__tests__/jest.config.ts --watch",
    "test:coverage": "jest --config src/__tests__/jest.config.ts --coverage",
    "test:integration": "jest --config src/__tests__/integration/jest.integration.config.ts",
    "test:integration:local": "node scripts/run-integration-local.js",
    "setup-test-db": "node scripts/setup-test-db.js",
    "test:perf": "k6 run src/__tests__/performance/load/*.perf.ts"
  },
  "dependencies": {
    "@pm/backend-common": "file:../packages/backend-common",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.2",
    "pg": "^8.17.2",
    "pino": "^9.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/k6": "^1.5.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
